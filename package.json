{
    "name": "@ostro/router",
    "version": "2.0.0-alpha.1",
    "description": "Router module for OstroJS",
    "main": "build/router.js",
    "types": "build/router.d.ts",
    "files": [
        "build"
    ],
    "exports": {
        ".": {
            "types": "./build/router.d.ts",
            "default": "./build/router.js"
        },
        "./*": {
            "types": "./build/*.d.ts",
            "default": "./build/*.js"
        }
    },
    "scripts": {
        "build": "rm -rf build && npx tsc -p tsconfig.build.json && node -e \"const fs=require(\\\"fs\\\"); if(fs.existsSync(\\\"src/console/stubs\\\"))fs.cpSync(\\\"src/console/stubs\\\",\\\"build/console/stubs\\\",{recursive:true});\" && node scripts/build.js",
        "prepublishOnly": "npm run build",
        "test": "npx c8 npx jest",
        "clean": "rm -rf build coverage"
    },
    "dependencies": {
        "@ostro/cache": "^2.0.0-alpha.1",
        "@ostro/console": "^2.0.0-alpha.1",
        "@ostro/contracts": "^2.0.0-alpha.1",
        "@ostro/http": "^2.0.0-alpha.1",
        "@ostro/support": "^2.0.0-alpha.1",
        "array-flatten": "^3.0.0",
        "lodash.difference": "^4.5.0",
        "path-to-regexp": "^6.2.0"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "router",
        "routing"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/router.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/router/issues"
    },
    "homepage": "https://github.com/ostrojs/router#readme",
    "devDependencies": {
        "typescript": "^5.8.0",
        "@types/node": "^22.0.0",
        "@types/jest": "^30.0.0",
        "c8": "^10.1.3",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2"
    },
    "overrides": {
        "sprintf-js": "^1.1.3",
        "braces": "^3.0.3",
        "argparse": "^2.0.1",
        "js-yaml": "^4.1.0"
    }
}
